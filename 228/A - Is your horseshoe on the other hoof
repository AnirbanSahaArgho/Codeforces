#include <stdio.h>
#include <stdlib.h>
 
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}
 
int count_distinct(int arr[], int size) {
    if (size == 0) return 0;
 
    qsort(arr, size, sizeof(int), compare);
 
    int count = 1;
    for (int i = 1; i < size; i++) {
        if (arr[i] != arr[i - 1]) {
            count++;
        }
    }
    return count;
}
 
int main() {
    int arr[4];
    for(int i=0;i<4;i++)
    {
        scanf("%d",&arr[i]);
    }
    int size = 4;
 
    int distinct_count = count_distinct(arr, size);
    printf("%d
",4- distinct_count);
 
    return 0;
}