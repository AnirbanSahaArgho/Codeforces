#include<stdio.h>
#include<string.h>
int main()
{
    int t;
    scanf("%d",&t);
    while(t--)
    {
        char s[101];
        scanf("%s",s);
        int x=strlen(s),count=0;
        if(x%2!=0)
        {
            printf("NO
");
        }
        else{
            for(int i=0;i<x/2;i++)
            {
                if(s[i]==s[(x/2)+i])
                {
                    count++;
                }
            }
            if(count==x/2) printf("YES
");
            else printf("NO
");
        }
    }
    return 0;
}