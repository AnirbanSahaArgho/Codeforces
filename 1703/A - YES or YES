#include<bits/stdc++.h>
using namespace std;
 
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        string s;
        cin>>s;
        for(int i=0;i<s.size();i++)
        {
            switch(s[i])
            {
            case 'Y':
            case 'y':
                {
                    s[i]='y';
                    break;
                }
            case 'E':
            case 'e':
                {
                    s[i]='e';
                    break;
                }
            case 'S':
            case 's':
                {
                    s[i]='s';
                    break;
                }
            }
        }
        if(s=="yes")
            cout<<"YES"<<endl;
        else
            cout<<"NO"<<endl;
    }
    return 0;
}